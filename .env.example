# ------------------------------------------------------------ Supabase (data)
# Dashboard > Project Settings > API. The anon key is safe in the client;
# RLS is what protects the data. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------------------- Sentry (error reports)
# Optional. Leave unset and error reporting is simply off — the app still runs
# and still logs to the console. A DSN is an ingest endpoint, not a secret, so
# EXPO_PUBLIC_ is correct here. Never put a Sentry *auth token* in this file.
# Sentry > Project Settings > Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
# Set to "true" to also report from `expo start` builds (off by default, so a
# development session does not flood the project).
EXPO_PUBLIC_SENTRY_DEBUG=

# -------------------------------------------------- Website (shareable links)
# Origin of the deployed web build, no trailing slash. Share turns this into
# ${EXPO_PUBLIC_SITE_URL}/properties/<id>, which is a link a recipient can open
# in a browser. Leave it unset and the share button says sharing is not
# configured rather than sending an exp:// or localhost URL that only works on
# the developer's machine.
EXPO_PUBLIC_SITE_URL=https://restate.example.com

# ----------------------------------------------------- Sifalo Pay (payments)
# Sifalo Pay credentials. Stored on the server as Edge Function secrets
# (supabase secrets set SIFALO_API_USER=... SIFALO_API_KEY=...).
# Never prefix with EXPO_PUBLIC_ — they must not reach the client.
SIFALO_API_USER=su_...
SIFALO_API_KEY=sp_...
